Name: array keep upper triangle 1
=-=
subroutine deviatoric_strain_rate()
     Tsym33 = [  (2*dx_du - div23),          dx_dv + dy_du,        dx_dw + dy_du, &
                                         (2*dy_dv - div23),        dx_dw + dz_du, &
                                                               (2*dz_dw - div23)  ]
end subroutine deviatoric_strain_rate
