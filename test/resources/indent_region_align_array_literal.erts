Name: array literal primary 5
=-=
! both-left-primary: the left aligned position is primary, the
! first element is the anchor, content of an unary minus is aligned with the others
module poly
real, dimension(1:3,1:12), parameter, public :: &
POLYHEDRON_icosahedron = reshape( &
[  -r,   s, 0.0, &
r,   s, 0.0, &
-r,  -s, 0.0, &
r,  -s, 0.0, &
0.0,  -r,   s, &
0.0,   r,   s, &
0.0,  -r,  -s, &
0.0,   r,  -s, &
s, 0.0,  -r, &
s, 0.0,   r, &
-s, 0.0,  -r, &
-s, 0.0,   r &
], &
[3,12])
end module poly
=-=
! both-left-primary: the left aligned position is primary, the
! first element is the anchor, content of an unary minus is aligned with the others
module poly
 real, dimension(1:3,1:12), parameter, public :: &
        POLYHEDRON_icosahedron = reshape( &
               [  -r,   s, 0.0, &
                   r,   s, 0.0, &
                  -r,  -s, 0.0, &
                   r,  -s, 0.0, &
                   0.0,  -r,   s, &
                   0.0,   r,   s, &
                   0.0,  -r,  -s, &
                   0.0,   r,  -s, &
                   s, 0.0,  -r, &
                   s, 0.0,   r, &
                  -s, 0.0,  -r, &
                  -s, 0.0,   r &
                  ], &
               [3,12])
end module poly
