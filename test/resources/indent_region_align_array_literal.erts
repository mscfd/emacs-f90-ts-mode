Name: align array literal 5
=-=
! note that "(/" after "rgb =" is aligned, and this alignment is preserved
subroutine arr5()
     character(len=5), dimension(1:3) :: & !! comment
          
          !! comment
          
                                  rgb = &
                                  (/ &
              'red  ', &
              'green', &
              'blue ' /), &
           alpha = 'trnsp'
end
=-=
