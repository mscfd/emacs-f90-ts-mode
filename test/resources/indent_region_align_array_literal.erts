r,   s, 0.0, &
-r,  -s, 0.0, &
r,  -s, 0.0, &
0.0,  -r,   s, &
0.0,   r,   s, &
0.0,  -r,  -s, &
0.0,   r,  -s, &
s, 0.0,  -r, &
s, 0.0,   r, &
-s, 0.0,  -r, &
-s, 0.0,   r &
], &
[3,12])
end module poly
