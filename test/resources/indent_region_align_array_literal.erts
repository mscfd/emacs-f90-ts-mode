Name: array literal primary 3
=-=
! some first commata are dropped, as they are too far left,
! but the last two lines are too far left, why?
! (a second f90-ts-mode-test--indent-by-region gives the expected)
subroutine edge()
x = (/ x+y, f(x), g(y), &
4.0, 5.0, 6.0, &
777777.0, 8.8, 9.9, &
u .cross. v, 10.10, 1.111, &
-12.13 &
/)
end subroutine edge
=-=
! some first commata are dropped, as they are too far left,
! but the last two lines are too far left, why?
! (a second f90-ts-mode-test--indent-by-region gives the expected)
subroutine edge()
     x = (/ x+y, f(x), g(y), &
            4.0, 5.0, 6.0, &
            777777.0, 8.8, 9.9, &
              u .cross. v, 10.10, 1.111, &
              -12.13 &
             /)
end subroutine edge
