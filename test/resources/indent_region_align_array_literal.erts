Name: array literal keep 1
=-=
! right aligned matrix, rows are aligned at the commata and are kept
module poly
 real, dimension(1:3,1:12), parameter, public :: &
        POLYHEDRON_icosahedron = reshape( &
               [  -r,   s, 0.0, &
                   r,   s, 0.0, &
                  -r,  -s, 0.0, &
                   r,  -s, 0.0, &
                 0.0,  -r,   s, &
                 0.0,   r,   s, &
                 0.0,  -r,  -s, &
                 0.0,   r,  -s, &
                   s, 0.0,  -r, &
                   s, 0.0,   r, &
                  -s, 0.0,  -r, &
                  -s, 0.0,   r &
                  ], &
               [3,12])
end module poly
=-=-=

Name: array literal keep 2
=-=
! the whole block is moved to the continued line position of the opening
! bracket, rows keep their column relative to their anchors: right aligned
! at a comma, directly behind the bracket and at the hanging position
module poly
 real, dimension(1:6,1:4), parameter :: &
        mat = reshape( &
            (/   1.0, -0.25,  10.5, 100.0, &
                -2.5,   3.0, 0.125,  -1.0, &
                22.0,   0.5, -3.75,  25.0, &
              0.0, -12.5,   7.0,   0.5, &
               100.0,   1.0,   1.0,   1.0, &
                   3.5,   4.5,   5.5,   6.5 &  ! continued line offset anchored at "mat..."
                /), &
            [6,4])
end module poly
=-=
! the whole block is moved to the continued line position of the opening
! bracket, rows keep their column relative to their anchors: right aligned
! at a comma, directly behind the bracket and at the hanging position
module poly
 real, dimension(1:6,1:4), parameter :: &
        mat = reshape( &
        (/   1.0, -0.25,  10.5, 100.0, &
            -2.5,   3.0, 0.125,  -1.0, &
            22.0,   0.5, -3.75,  25.0, &
          0.0, -12.5,   7.0,   0.5, &
           100.0,   1.0,   1.0,   1.0, &
               3.5,   4.5,   5.5,   6.5 &  ! continued line offset anchored at "mat..."
            /), &
        [6,4])
end module poly
=-=-=

Name: array literal keep 3
=-=
! keep rows aligned at a comma
! all others go to the continued line position
subroutine edge()
     x = [ 1.0, 22.0, 333.0, &
           4.0, 55.0, 6.0, &
              7777.0, 8.0, 9.0, &
          10.0, 1.0, &
    5.0, 6.0, 7.0, &
                   8.0, 9.0, 1.0, &
          11.0 &
            ]
end subroutine edge
=-=
