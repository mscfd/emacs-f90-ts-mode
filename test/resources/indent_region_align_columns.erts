Name: primary 1
=-=
! original column of u is the same as final column of y
! do not keep this accidental alignment
subroutine sub()
x=fun( &
x, y, z, &
              u)
end subroutine sub
=-=
! original column of u is the same as final column of y
! do not keep this accidental alignment
subroutine sub()
     x=fun( &
           x, y, z, &
           u)
end subroutine sub
=-=-=

