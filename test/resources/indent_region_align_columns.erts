Code:
  (lambda ()
    (f90-ts-mode)
    (let ((f90-ts-indent-list-line 'keep-or-continued-line))
      (f90-ts-mode-test--indent-by-line)))


Name: align arg keep or continued 1
=-=
! keep aligned args, the rest is moved to statement anchor + continued line offset
subroutine sub()
     call test(  arg1, arg2, arg3, &
            arg4, &
              arg5, &
               arg6, &
                arg7, &
                 arg8, &
                       arg9, &
                        argA, &
                             argB)
end subroutine sub
=-=
! keep aligned args, the rest is moved to statement anchor + continued line offset
subroutine sub()
     call test(  arg1, arg2, arg3, &
            arg4, &
            arg5, &
               arg6, &
            arg7, &
                 arg8, &
                       arg9, &
            argA, &
                             argB)
end subroutine sub
=-=-=
