Name: labelled do smart end 1
=-=
! note that this code is invalid, as the end is not seen as an end statement
! for the two labelled do's
subroutine sub()
     do 123, i = 1,234
          do 123, i = 1,234
|end
end
=-=
! note that this code is invalid, as the end is not seen as an end statement
! for the two labelled do's
subroutine sub()
     do 123, i = 1,234
          do 123, i = 1,234
123  end do|
end
=-=-=

