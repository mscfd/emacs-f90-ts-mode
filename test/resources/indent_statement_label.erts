Name: labelled do 1
=-=
! check indentation after continue statement
! (covered by catch-all rule to find the proper previous statement)
program p
do 10 i = 1, 3
do 20 j = 1, 3
x = 1
20 continue
x = 2
10 continue
end program p
=-=
! check indentation after continue statement
! (covered by catch-all rule to find the proper previous statement)
program p
 do 10 i = 1, 3
      do 20 j = 1, 3
           x = 1
20    continue
      x = 2
10 continue
end program p
