Name: align variable init declaration 1
=-=
subroutine init_decl()
real, target  :: x &
= 1, &
 y0123456789 &
= 1
real, pointer :: p &
=> null(), &
 p0123456789 &
=> null()
end subroutine init_decl
=-=
subroutine init_decl()
     real, target  :: x &
            = 1, &
                      y0123456789 &
            = 1
     real, pointer :: p &
            => null(), &
                      p0123456789 &
            => null()
end subroutine init_decl
=-=-=

Name: align variable init declaration 2
=-=
! "=" from x = 1 is not primary anchor
subroutine init_decl()
real, target  :: x = 1, &
y0123456789 & ! comment
 = 1
real, pointer :: p => null(), &
p0123456789 &
 => null()
end subroutine init_decl
=-=
! "=" from x = 1 is not primary anchor
subroutine init_decl()
     real, target  :: x = 1, &
                      y0123456789 & ! comment
            = 1
     real, pointer :: p => null(), &
                      p0123456789 &
            => null()
end subroutine init_decl
=-=-=

Name: align variable init declaration 3
=-=
! "=" from x = 1 is a seondary anchor, hence alignment should be preserved
subroutine init_decl()
     real, target  :: x = 1, &
                      y0123456789 & ! comment
                        = 1
     real, pointer :: p => null(), &
                      p0123456789 &
                        => null()
end subroutine init_decl
=-=-=

Name: align variable init declaration 4
=-=
! "=" and "=>" from first init declarator is not a primary choice
subroutine init_decl()
real, target  :: x = 1, y0123456789 & ! comment
= 1
real, pointer :: p => null(), p0123456789 &
=> null()
end subroutine init_decl
=-=
! "=" and "=>" from first init declarator is not a primary choice
subroutine init_decl()
     real, target  :: x = 1, y0123456789 & ! comment
            = 1
     real, pointer :: p => null(), p0123456789 &
            => null()
end subroutine init_decl
