end subroutine break_anywhere_if_necessary
=-=
!1 using any position in string if
!1 necessary
subroutine break_anywhere_if_necessary()
   s = '0123456789abcdefghijklmnopqrstu&
       &vwxyz0123456789 &
       &abcdefhijklmnopqrstuvwxyz'
end subroutine &
       break_anywhere_if_necessary
