    (f90-ts--fill-region-aux (point-min) (point-max) 40))

Name: fill all string 2
=-=
!1 make sure that leading ampersand does not interfere with break point loop
!1 (first string has default indentation right of ampersand, second has it
!1 left of ampersand),
!2 also test that indentation is always set to primary
subroutine sub()
     s0123456789 = "0123456789abcdef &
            &ghijklmnopqrs     &
            &tuvwxyz0 123456789"
     s="0123456789abcdef ghijklmnopq   &
            &  rstuvwxyz0 123456789 abcdefg &
            &hijklmnopqrst uvwxyz 0123456789"
end subroutine sub
=-=
!1 make sure that leading ampersand does
!1 not interfere with break point loop
!1 (first string has default indentation
!1 right of ampersand, second has it
!1 left of ampersand),
!2 also test that indentation is always
!2 set to primary
subroutine sub()
     s0123456789 = "0123456789abcdef &
                   &ghijklmnopqrs     &
                   &tuvwxyz0 123456789"
     s="0123456789abcdef ghijklmnopq   &
            &  rstuvwxyz0 123456789 &
            &abcdefg hijklmnopqrst &
            &uvwxyz 0123456789"
end subroutine sub
=-=-=
=-=-=

Skip: (not (f90-ts--string-literal-decomposed-p))
Name: fill all string 3
=-=
!1 test filling with comments within string
!2 test normal ampersand character in string, which does not act as a continuation symbol
!3 check that empty lines are preserved within strings
subroutine sub()
     s = "0123456789abcdef ghijklmnopq rstuvwxyz0 123456789 &
         !1 comment1 comment1 comment1 comment1 cooment1
         !1 comment2 comment2 comment2 comment2 cooment2
         !2 domment domment domment domment domment

         &  abcdef ghijklmnopq rstuvwxyz0 123456789 &rstuvwxyz0 123456789"
end subroutine sub
=-=
!1 test filling with comments within
!1 string
!2 test normal ampersand character in
!2 string, which does not act as a
!2 continuation symbol
!3 check that empty lines are preserved
!3 within strings
subroutine sub()
     s = "0123456789abcdef ghijklmnopq &
         &rstuvwxyz0 123456789 &
         !1 comment1 comment1 comment1
         !1 comment1 cooment1 comment2
         !1 comment2 comment2 comment2
         !1 cooment2
         !2 domment domment domment
         !2 domment domment

         &  abcdef ghijklmnopq &
         &rstuvwxyz0 123456789 &&
         &rstuvwxyz0 123456789"
end subroutine sub
=-=-=
=-=-=

