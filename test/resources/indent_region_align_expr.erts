Name: align unary minus 2
=-=
subroutine unary_minus_2()
A = [ 1, 2, &
-3, 4, &
-(a+b), 5, &
+6, +7,&
8, 9, &
.myop. c, d]
call foo(   .not. f1, &
-x1, &
x2, &
x1+x2, &
-x1+x2+x3+x4, &
-x1==x2, &
-x1==x2 .or. x1 == 3, &
+x1==x2, &
(f2 .and. f3), &
f2 .or. f3, &
.not. f2 .or. .not. f3 .or. f4, &
.not. f2 .or. .not. f3 .nor. f4, &
.not. f2 .imply. .not. f3 .or. f4, &
.not. f4, &
.other. x3, &
! comment
)
end subroutine unary_minus_2
=-=
subroutine unary_minus_2()
     A = [ 1, 2, &
          -3, 4, &
          -(a+b), 5, &
          +6, +7,&
           8, 9, &
           .myop. c, d]
     call foo(   .not. f1, &
                -x1, &
                 x2, &
                 x1+x2, &
                -x1+x2+x3+x4, &
                -x1==x2, &
                -x1==x2 .or. x1 == 3, &
                +x1==x2, &
                 (f2 .and. f3), &
                 f2 .or. f3, &
                 .not. f2 .or. .not. f3 .or. f4, &
                 .not. f2 .or. .not. f3 .nor. f4, &
                 .not. f2 .imply. .not. f3 .or. f4, &
                 .not. f4, &
                 .other. x3, &
              ! comment
                )
end subroutine unary_minus_2
=-=-=

Name: align unary minus 3
=-=
subroutine sub()
! works partially
x0123456789 =  - &
5 + &
6
! works partially
x0123456789 =   5 + &
- &
6
! works (is it expected to align --5 with 123456?)
x0123456789 =   123456 - &
-      --5
! works
x0123456789 = 5 **&
-2
! works
x0123456789 = 5 &
** -2
end subroutine sub
=-=
subroutine sub()
     ! works partially
     x0123456789 =  - &
                     5 + &
                     6
     ! works partially
     x0123456789 =   5 + &
                    - &
                     6
     ! works (is it expected to align --5 with 123456?)
     x0123456789 =   123456 - &
              -      --5
     ! works
     x0123456789 = 5 **&
                  -2
     ! works
     x0123456789 = 5 &
                  ** -2
end subroutine sub
