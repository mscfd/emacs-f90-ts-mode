Name: preserve alignment 2
=-=
module poly
 ! the array block opening symbol "[" is aligned with the first
 ! and second line of the statement below, the second line is more relevant
 ! and should be used as anchor, to move the whole block to the right
 real, dimension(1:3,1:12), parameter, public :: &
 POLYHEDRON_icosahedron = reshape( &
        [ -r,    s,    0.0, &
           r,    s,    0.0, &
          -r,   -s,    0.0, &
           r,   -s,    0.0, &
           0.0, -r,    s, &
           0.0,  r,    s, &
           0.0, -r,   -s, &
           0.0,  r,   -s, &
           s,    0.0, -r, &
           s,    0.0,  r, &
          -s,    0.0, -r, &
          -s,    0.0,  r &
           ], &
        [3,12])
end module poly
=-=
module poly
 ! the array block opening symbol "[" is aligned with the first
 ! and second line of the statement below, the second line is more relevant
 ! and should be used as anchor, to move the whole block to the right
 real, dimension(1:3,1:12), parameter, public :: &
        POLYHEDRON_icosahedron = reshape( &
               [ -r,    s,    0.0, &
                  r,    s,    0.0, &
                 -r,   -s,    0.0, &
                  r,   -s,    0.0, &
                  0.0, -r,    s, &
                  0.0,  r,    s, &
                  0.0, -r,   -s, &
                  0.0,  r,   -s, &
                  s,    0.0, -r, &
                  s,    0.0,  r, &
                 -s,    0.0, -r, &
                 -s,    0.0,  r &
                  ], &
               [3,12])
end module poly
