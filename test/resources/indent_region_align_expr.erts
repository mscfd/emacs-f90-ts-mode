Name: align unary minus 1
=-=
subroutine unary_minus_1()
real, dimension(1:10), parameter :: &
bernoulli = (/ 1.0, -0.5, 0.16667, 0.0, &
-0.03333, 0.0, &
0.0238, 0.0 &
/)
end subroutine unary_minus_1
=-=
