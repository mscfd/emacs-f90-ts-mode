subroutine sub()
! works partially
x0123456789 =  - &
5 + &
6
! works partially
x0123456789 =   5 + &
- &
6
! works (is it expected to align --5 with 123456?)
x0123456789 =   123456 - &
-      --5
! works
x0123456789 = 5 **&
-2
! works
x0123456789 = 5 &
** -2
end subroutine sub
=-=
subroutine sub()
     ! works partially
     x0123456789 =  - &
                     5 + &
                     6
     ! works partially
     x0123456789 =   5 + &
                    - &
                     6
     ! works (is it expected to align --5 with 123456?)
     x0123456789 =   123456 - &
              -      --5
     ! works
     x0123456789 = 5 **&
                  -2
     ! works
     x0123456789 = 5 &
                  ** -2
end subroutine sub
