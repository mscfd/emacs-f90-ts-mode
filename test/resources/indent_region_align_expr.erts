Name: align nested expression 2
=-=
subroutine sub()
integer, parameter :: cos_phi &
= cos(&
3.14159265/180.0 * (&
phi_1 + &
phi_2) &
), &
cos_psi &
= cos(&
3.14159265/180.0 * (&
-psi_1 - &
psi_2) &
)
end subroutine sub
=-=
subroutine sub()
     integer, parameter :: cos_phi &
            = cos(&
                  3.14159265/180.0 * (&
                         phi_1 + &
                         phi_2) &
                    ), &
                           cos_psi &
            = cos(&
                  3.14159265/180.0 * (&
                         -psi_1 - &
                          psi_2) &
                    )
end subroutine sub
