Name: align unary minus 4
=-=
! These are pathological corner cases, testing a large minus offset
! (due to the many blanks between minus and expression) required to
! align the content of an unary minus operator.
!
! The first two assignments cannot be aligned properly, but it must
! not fail and be somewhat reasonable:
!
! The first gives a rather bad (non idem potent case) as it hits
! limitations in the region indent cache, which only caches buffered
! deltas for continued lines, and not the whole region to be indented.
!
! The second can choose the minimal column at 0, but is still unable
! to align, obviously.
subroutine unary_minus_4()
x = [ 1, 2, &
-           3, 4]
     x = [ 1, 2, &
-           3, 4]
x0123456 = [ 1, 2, &
-           3, 4]
x0123456 = [               1, 2, &
-           3, 4]
end subroutine unary_minus_4
=-=
! These are pathological corner cases, testing a large minus offset
! (due to the many blanks between minus and expression) required to
! align the content of an unary minus operator.
!
! The first two assignments cannot be aligned properly, but it must
! not fail and be somewhat reasonable:
!
! The first gives a rather bad (non idem potent case) as it hits
! limitations in the region indent cache, which only caches buffered
! deltas for continued lines, and not the whole region to be indented.
!
! The second can choose the minimal column at 0, but is still unable
! to align, obviously.
subroutine unary_minus_4()
     x = [ 1, 2, &
     -           3, 4]
     x = [ 1, 2, &
-           3, 4]
     x0123456 = [ 1, 2, &
      -           3, 4]
     x0123456 = [               1, 2, &
                    -           3, 4]
end subroutine unary_minus_4
=-=-=

Name: preserve alignment 1
=-=
module poly
 real, dimension(1:3,1:12), parameter, public :: &
       POLYHEDRON_icosahedron = reshape( &
              [ -r,    s,    0.0, &
                 r,    s,    0.0, &
                -r,   -s,    0.0, &
                 r,   -s,    0.0, &
                 0.0, -r,    s, &
                 0.0,  r,    s, &
                 0.0, -r,   -s, &
                 0.0,  r,   -s, &
                 s,    0.0, -r, &
                 s,    0.0,  r, &
                -s,    0.0, -r, &
                -s,    0.0,  r &
                 ], &
              [3,12])
end module poly
=-=
