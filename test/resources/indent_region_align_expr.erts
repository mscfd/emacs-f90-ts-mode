Name: align math expression 1
=-=
! this checks the continued-line-cache, which is required
! to select to proper primary column for the two last lines
! of the continued statement
subroutine sub()
x = 5 + 6 &
* 7 &
- 8 + &
y
end subroutine sub
=-=
! this checks the continued-line-cache, which is required
! to select to proper primary column for the two last lines
! of the continued statement
subroutine sub()
     x = 5 + 6 &
           * 7 &
           - 8 + &
         y
end subroutine sub
