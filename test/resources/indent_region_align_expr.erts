integer, intent(in) :: n, m, k
real, intent(inout) :: a(n, &
m)
real, intent(in)    :: b(1: &
n, &
1: & ! comment
m)
real, intent(inout) :: w(0: &
n+1, 0:m+1)
real, intent(inout) :: t(-n: &
n)
real, allocatable   :: s(:, &
:), &
v(: &
)
integer             :: i, j
