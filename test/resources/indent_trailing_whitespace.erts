Code:
  (lambda ()
    (f90-ts-mode)
    (f90-ts-indent-and-complete-stmt))

Name: indent stmt with whitespace 1
=-=
! trailing ws are removed only in complemented end statements
subroutine sub()  
    do i = 1,10  
    
       print *,i  
end  
end  |  
=-=
! trailing ws are removed only in complemented end statements
subroutine sub()  
     do i = 1,10  
    
          print *,i  
     end do
end subroutine sub|
