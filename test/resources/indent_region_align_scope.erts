Code:
  (lambda ()
    (f90-ts-mode)
    (let ((f90-ts-indent-list-region 'keep-or-primary))
      (indent-region (point-min) (point-max))))

Name: use statement keep or primary 1
=-=
! alignment of use statement with renaming, including comments
subroutine sub_use()
use mod3, only: fun1 => mod3_fun1, &
fun2 => mod3_fun2, &
! one more
fun3 => mod3_fun3
use mod4, a => b, &
         c => d
end subroutine sub_use
=-=
! alignment of use statement with renaming, including comments
subroutine sub_use()
     use mod3, only: fun1 => mod3_fun1, &
                     fun2 => mod3_fun2, &
                     ! one more
                     fun3 => mod3_fun3
     use mod4, a => b, &
               c => d
end subroutine sub_use
=-=-=

Name: use statement keep or primary 2
=-=
! first item on continued line: use standard continued line indentation
subroutine sub_use()
use mod5, only: &
a, &
          b, &
   ! comment
          c
end subroutine sub_use
=-=
! first item on continued line: use standard continued line indentation
subroutine sub_use()
     use mod5, only: &
            a, &
            b, &
            ! comment
            c
end subroutine sub_use
=-=-=


