end module foo
=-=-=

Name: use statement keep 4
=-=
module foo
 use mod3, &
        only: bar111111111111 => &
              mod2_fun1, &
              ! comment aligned as well
              bar222222222222 => &
        mod2_fun2 ! anchored at "use" + continued offset
end module foo
=-=-=

Name: use statement keep 5
=-=
module foo
contains
 subroutine bar()
      use mod3, only: fun1 => mod3_fun1, &
             fun2 => mod3_fun2, &
             ! one more
                      fun3 => mod3_fun3
 end subroutine bar
end module foo
