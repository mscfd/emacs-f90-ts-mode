Point-Char: |

Code:
  (lambda ()
    (f90-ts-mode)
    (let ((f90-ts-indent-list-region 'primary))
      (indent-region (point-min) (point-max))))

Name: use statement primary 1
=-=
module foo
 use mod0
 use mod1, only: sub1, &
                 sub2
end module foo
=-=-=

Name: use statement primary 2
=-=
module foo
 use mod2, only: fun1 => mod2_fun1, &
                 ! comment aligned as well
                 fun2 => mod2_fun2, &
                 fun3_as_is
end module foo
=-=-=

Name: use statement primary 3
=-=
module foo
 use mod3, fun1 => mod3_fun1, &
           fun2 => mod3_fun2, &
           ! one more
           fun3 => mod3_fun3
end module foo
=-=-=

Name: use statement primary 4
=-=
module foo
 use mod3, only: bar111111111111 &
                        => mod2_fun1, &
                 ! comment aligned as well
                 bar222222222222 &
                        => mod2_fun2
end module foo
=-=-=

Name: use statement primary 5
=-=
module foo
 use mod3, bar111111111111 &
                  => mod2_fun1, &
           ! comment aligned as well
           bar222222222222 &
                  => mod2_fun2
end module foo
=-=-=

Name: use statement primary 6
=-=
! break before and after "=>": continued offset relative to the lhs
subroutine sub_use()
use mod6, only: fun1 => &
mod6_fun1, &
fun2 &
=> mod6_fun2, &
        fun3 => mod6_fun3
end subroutine sub_use
=-=
! break before and after "=>": continued offset relative to the lhs
subroutine sub_use()
     use mod6, only: fun1 => &
                            mod6_fun1, &
                     fun2 &
                            => mod6_fun2, &
                     fun3 => mod6_fun3
end subroutine sub_use
=-=-=

Name: use statement primary 7
=-=
module foo
 use mod3, &
        only: bar111111111111 => &
                     mod2_fun1, &
              ! comment aligned as well
              bar222222222222 => &
                     mod2_fun2
end module foo
=-=-=

